# Copy this file to .env and fill in real values. Never commit .env itself.

# Gemini, used for listing extraction, eligibility interpretation, and trust
# reasoning.
GOOGLE_API_KEY=

# Optional second Gemini key, used only for filtering search-evidence
# relevance in src/search.js. Gives that step its own separate 20/day free
# quota instead of competing with the main pipeline for GOOGLE_API_KEY's
# quota. If unset, GOOGLE_API_KEY is reused for everything.
GOOGLE_API_KEY_SEARCH=

# Alternatives to Gemini: set LLM_PROVIDER=openrouter and OPENROUTER_API_KEY
# to use OpenRouter (src/llm-openrouter.js), or LLM_PROVIDER=groq and
# GROQ_API_KEY to use Groq (src/llm-groq.js). Useful when Google Cloud
# Billing isn't available at all in your country, since both have real free
# models with no billing requirement. Gemini stays the default. OpenRouter's
# free tier is a single 50-requests/day cap shared across every free model on
# the account, which exhausted mid-run in production once; Groq's free tier
# is rate-limited per-model per-minute instead, and held up better.
LLM_PROVIDER=
OPENROUTER_API_KEY=
GROQ_API_KEY=
