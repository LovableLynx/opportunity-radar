# Copy this file to .env and fill in real values. Never commit .env itself.

# Groq is the default provider, used for listing extraction, eligibility
# interpretation, and trust reasoning. Its free tier is rate-limited
# per-model per-minute rather than one tight shared daily cap, so it holds
# up across a full run better than Gemini or OpenRouter's free tiers do.
GROQ_API_KEY=

# Optional: overrides src/llm-groq.js's default model (openai/gpt-oss-20b).
# Groq deprecates/removes models from its catalog from time to time
# (llama-3.3-70b-versatile 404'd in production once already), so this lets
# the model be swapped via an env var and a rebuild instead of a code
# change, if the current default is ever pulled too. Check console.groq.com
# for the current model list before setting this.
GROQ_MODEL=

# Fallbacks: set LLM_PROVIDER=gemini and GOOGLE_API_KEY to use Gemini
# (src/main.js) instead, or LLM_PROVIDER=openrouter and OPENROUTER_API_KEY
# to use OpenRouter (src/llm-openrouter.js). Any other value, including
# unset, uses Groq.
#
# Gemini's free tier is capped at 20 requests/day per key, too small to
# survive a real run once search-evidence relevance filtering and matching
# are both drawing from it. OpenRouter's free tier is a single
# 50-requests/day cap shared across every free model on the account, which
# exhausted mid-run in production once and crashed the Actor before
# src/match.js was hardened to degrade instead of crash on a failed LLM call.
LLM_PROVIDER=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional second Gemini key, only used if LLM_PROVIDER=gemini, for
# filtering search-evidence relevance in src/search.js. Gives that step its
# own separate 20/day free quota instead of competing with the main
# pipeline for GOOGLE_API_KEY's quota. If unset, GOOGLE_API_KEY is reused
# for everything.
GOOGLE_API_KEY_SEARCH=
