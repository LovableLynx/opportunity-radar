# Copy this file to .env and fill in real values. Never commit .env itself.

# Gemini, used for listing extraction, eligibility interpretation, and trust
# reasoning.
GOOGLE_API_KEY=

# Google Custom Search JSON API, used to check whether a listing has an
# independent web presence beyond its own source page (trust scoring).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
