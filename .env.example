# Copy this file to .env and fill in real values. Never commit .env itself.

# Gemini, used for listing extraction, eligibility interpretation, and trust
# reasoning.
GOOGLE_API_KEY=

# Optional second Gemini key, used only for filtering search-evidence
# relevance in src/search.js. Gives that step its own separate 20/day free
# quota instead of competing with the main pipeline for GOOGLE_API_KEY's
# quota. If unset, GOOGLE_API_KEY is reused for everything.
GOOGLE_API_KEY_SEARCH=

# Alternative to Gemini: set LLM_PROVIDER=openrouter and OPENROUTER_API_KEY
# to use OpenRouter instead (src/llm-openrouter.js). Useful when Google Cloud
# Billing isn't available at all in your country, since OpenRouter has real
# free models with no billing requirement. Gemini stays the default.
LLM_PROVIDER=
OPENROUTER_API_KEY=
